 <!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>sweet | متجر حلويات فاخرة</title>
    <style>
        /* تنسيقات أساسية للمتجر */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #fcf8f5;
            color: #4a3728;
            margin: 0;
            padding: 0;
        }
        header {
            background-color: #ffffff;
            text-align: center;
            padding: 30px 10px;
            border-bottom: 2px solid #f3e1d3;
            box-shadow: 0 4px 6px rgba(0,0,0,0.02);
        }
        header h1 {
            margin: 0;
            font-size: 2.5rem;
            color: #d4a373;
        }
        header p {
            margin: 5px 0 0;
            font-size: 1.1rem;
            color: #8c7867;
        }
        .container {
            max-width: 1200px;
            margin: 40px auto;
            padding: 0 20px;
        }
        /* شبكة عرض الصور والمنتجات */
        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
        }
        .product-card {
            background-color: #ffffff;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 10px 20px rgba(0,0,0,0.05);
            transition: transform 0.3s ease;
            border: 1px solid #f1eae4;
            display: flex;
            flex-direction: column;
        }
        .product-card:hover {
            transform: translateY(-5px);
        }
        .product-image {
            width: 100%;
            height: 250px;
            object-fit: cover; /* يضمن عدم تشوه أبعاد الصورة */
            background-color: #f9f6f0;
        }
        .product-info {
            padding: 20px;
            text-align: center;
            flex-grow: 1;
        }
        .product-info h3 {
            margin: 0 0 10px;
            font-size: 1.3rem;
            color: #4a3728;
        }
        .product-price {
            font-weight: bold;
            color: #d4a373;
            font-size: 1.2rem;
            margin-bottom: 15px;
        }
        .order-btn {
            background-color: #d4a373;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 25px;
            cursor: pointer;
            font-size: 1srem;
            font-weight: bold;
            transition: background-color 0.3s;
            width: 100%;
        }
        .order-btn:hover {
            background-color: #bfa280;
        }
        footer {
            text-align: center;
            padding: 20px;
            background-color: #4a3728;
            color: #fcf8f5;
            margin-top: 60px;
        }
    </style>
</head>
